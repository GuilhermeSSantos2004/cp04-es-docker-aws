#!/bin/bash
set -euxo pipefail

exec > >(tee /var/log/cp04-bootstrap.log | logger -t cp04-bootstrap -s 2>/dev/console) 2>&1

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

docker pull "${docker_image}"
docker rm -f cp04-site || true
docker run \
  --detach \
  --name cp04-site \
  --restart unless-stopped \
  --publish 80:80 \
  "${docker_image}"

for attempt in $(seq 1 30); do
  if curl --fail --silent http://localhost/ >/dev/null; then
    touch /var/lib/cloud/instance/cp04-ready
    exit 0
  fi
  sleep 2
done

echo "O container não respondeu dentro do tempo esperado." >&2
exit 1
