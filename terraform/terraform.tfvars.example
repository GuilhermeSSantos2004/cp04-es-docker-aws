aws_region   = "us-east-1"
project_name = "cp04-es"
instance_type = "t2.micro"

# Substitua pelo seu usuário real do Docker Hub.
docker_image = "SEU_USUARIO_DOCKERHUB/cp04-site:cp04"

# Deixe ambos como null para não abrir a porta 22.
# Para usar SSH, informe um key pair existente e apenas o seu IP público /32.
key_name        = null
ssh_allowed_cidr = null
